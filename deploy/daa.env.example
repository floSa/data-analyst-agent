# Modèle du fichier d'environnement du SERVICE. À copier vers
# /etc/data-analyst-agent/daa.env, à remplir, et à mettre en 0600 :
#
#     sudo install -D -m 0600 deploy/daa.env.example /etc/data-analyst-agent/daa.env
#     sudo ${EDITOR:-nano} /etc/data-analyst-agent/daa.env
#
# CE FICHIER-CI est un modèle versionné : il ne contient aucune valeur secrète,
# et ne doit jamais en contenir. Le fichier rempli, lui, vit HORS du dépôt et
# n'y entre jamais — c'est le seul endroit où le mot de passe Postgres et la
# clé d'API du moteur sont écrits en clair, et il est lisible du seul root.
#
# Il ne remplace pas le `.env` du dépôt, qui sert au développement depuis le
# dossier de travail. Le service ne lit que celui-ci.

# --- Où vivent les données ---------------------------------------------------
# UN seul dossier, monté au MÊME chemin dans le conteneur (cf. compose.yaml).
# Tout ce qui peut finir monté dans le bac à sable vit dessous : les
# conversations, les fichiers des sources, les CSV temporaires.
# Il survit à la reconstruction de l'image ; c'est lui, et lui seul, que la
# sauvegarde emporte (deploy/backup.sh).
DAA_DATA_DIR=/var/lib/data-analyst-agent

# --- Port publié -------------------------------------------------------------
# 127.0.0.1 par défaut : le cookie de session est `Secure`, donc une exposition
# publique passe par une terminaison TLS devant, pas par ce port.
DAA_HTTP_BIND=127.0.0.1
DAA_HTTP_PORT=8000

# --- Accès au démon Docker (pour lancer le bac à sable) ----------------------
# Le gid du groupe propriétaire de /var/run/docker.sock, PROPRE À LA MACHINE :
#     stat -c %g /var/run/docker.sock
DAA_DOCKER_GID=

# --- Moteur LLM (endpoint OpenAI-compatible) ---------------------------------
# vLLM, service partagé du dépôt llm-service, qui tourne SUR L'HÔTE : depuis un
# conteneur, `localhost` désigne le conteneur — d'où host.docker.internal, que
# compose.yaml fait pointer sur la passerelle de l'hôte.
DAA_LLM_BASE_URL=http://host.docker.internal:8100/v1
DAA_LLM_MODEL=google/gemma-4-E4B-it-qat-w4a16-ct
# À renseigner UNIQUEMENT si le serveur a été lancé avec --api-key ; il rejette
# alors toute requête sans en-tête Authorization. SECRET.
DAA_LLM_API_KEY=

# --- Chemins applicatifs, tous sous DAA_DATA_DIR -----------------------------
# Écrits en dur et non dérivés : le conteneur n'interpole pas les variables
# entre elles, et un chemin faux ici se voit tout de suite.
DAA_CATALOG_PATH=/var/lib/data-analyst-agent/sources/catalogue.yaml
DAA_MODELS_REGISTRY_PATH=/var/lib/data-analyst-agent/models/registry.yaml
DAA_WORKSPACE_DIR=/var/lib/data-analyst-agent/workspaces
DAA_AUTH_ACCOUNTS_PATH=/var/lib/data-analyst-agent/users.yaml
DAA_AUTH_STATE_DIR=/var/lib/data-analyst-agent/auth
# Les tables d'une source SQL sont matérialisées en CSV dans un dossier
# temporaire, puis MONTÉES dans le bac à sable. Sans cette ligne elles
# atterrissent dans le /tmp du conteneur, que l'hôte ne connaît pas : le
# montage désignerait un chemin inexistant et l'analyse tournerait à vide.
TMPDIR=/var/lib/data-analyst-agent/tmp

# --- Sessions ----------------------------------------------------------------
# `true` (défaut du code) = le cookie ne part que sur HTTPS. À laisser `false`
# tant que l'accès se fait en http derrière 127.0.0.1 ; à repasser à `true` dès
# qu'une terminaison TLS est en place.
DAA_SESSION_COOKIE_SECURE=false

# --- Sources Postgres (si le catalogue en déclare) ---------------------------
# Le DSN du catalogue résout ces variables. L'hôte, vu du conteneur, est
# host.docker.internal — pas localhost.
DAA_PG_HOST=host.docker.internal
DAA_PG_PORT=5432
DAA_PG_USER=postgres
# SECRET. C'est pour cette ligne que le fichier est en 0600.
DAA_PG_PASSWORD=
