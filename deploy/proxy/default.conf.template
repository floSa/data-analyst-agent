# La terminaison TLS devant l'application.
#
# GABARIT : l'image nginx passe tout ce qui est sous /etc/nginx/templates/ dans
# `envsubst` au démarrage et écrit le résultat dans /etc/nginx/conf.d/. Le nom
# `default.conf` est délibéré — il REMPLACE la configuration d'accueil livrée
# avec l'image, au lieu de cohabiter avec elle.
#
# `NGINX_ENVSUBST_FILTER=^DAA_` (cf. compose.yaml) limite la substitution aux
# variables de ce projet : les $variables de nginx — $host, $scheme,
# $remote_addr — traversent le gabarit intactes, et se lisent ici telles
# qu'elles s'écrivent dans une configuration ordinaire.

# Rediriger le clair vers le chiffré plutôt que de le refuser : quelqu'un qui
# tape l'adresse sans préfixe arrive en http, et un refus sec ressemble à une
# panne. 308 et non 302 — la méthode et le corps sont conservés.
#
# Le port est explicite dans la cible parce qu'il n'est pas devinable : le
# service n'écoute pas forcément sur 443. Posé À 443, la redirection porte un
# `:443` superflu que tout navigateur avale sans broncher.
server {
    listen 80 default_server;
    server_name _;
    return 308 https://$host:${DAA_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    # Montés en lecture seule depuis DAA_TLS_DIR, hors du dépôt (cf. tls-cert.sh).
    ssl_certificate     /etc/nginx/tls/serveur.crt;
    ssl_certificate_key /etc/nginx/tls/serveur.key;

    # TLS 1.2 au plancher : 1.0 et 1.1 sont retirés des navigateurs, les garder
    # n'ouvrirait le service à personne de plus.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:daa:10m;
    ssl_session_timeout 1d;
    # Pas de tickets de reprise : sans rotation de leur clé, ils coûtent la
    # confidentialité persistante que les suites ECDHE viennent d'apporter.
    ssl_session_tickets off;

    # L'adresse RÉELLE du pair en premier, puis la chaîne annoncée. Sans ces
    # deux champs côte à côte, on ne peut pas distinguer « le mandataire
    # n'ajoute pas son maillon » de « l'application ne le lit pas » — et c'est
    # la première question qu'on se pose quand un verrouillage compte de travers.
    log_format  daa '$remote_addr "$http_x_forwarded_for" $host '
                    '"$request" $status $body_bytes_sent $request_time';
    access_log  /var/log/nginx/access.log daa;

    # HSTS. `always` pour que l'en-tête accompagne AUSSI les réponses d'erreur —
    # sans quoi un 502 laisserait le navigateur oublier la consigne. Ni
    # `preload` ni `includeSubDomains` : sur un nom interne, engager tous les
    # sous-domaines d'une machine qu'on ne maîtrise pas seul se paie cher.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # L'application est servie depuis ses propres gabarits, sans aucun asset
    # externe : rien ici n'a de raison d'être encadré ailleurs.
    add_header X-Frame-Options        "DENY"      always;
    add_header X-Content-Type-Options "nosniff"   always;
    add_header Referrer-Policy        "same-origin" always;

    # Plafond DUR, devant celui de l'application. Le middleware applicatif ne
    # contrôle que `Content-Length` : une requête en `chunked` n'en annonce pas
    # et passe. Ici, nginx compte ce qu'il lit. 128 Kio = le double du plafond
    # applicatif, pour que ce soit bien l'application qui réponde 413 sur un
    # corps simplement trop gros, et le mandataire seulement sur l'abus.
    client_max_body_size 128k;

    # La version du serveur dans chaque réponse ne sert qu'à qui cherche une
    # faille connue.
    server_tokens off;

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;

        # Le nom demandé par le client, pas `app` : l'application ne construit
        # pas d'URL absolue aujourd'hui, mais un mandataire qui réécrit Host est
        # un mandataire dont on s'aperçoit le jour où elle le fera.
        proxy_set_header Host              $host;
        # Le maillon qu'on ajoute À DROITE de ce que le client a pu raconter.
        # C'est en remontant depuis la droite que l'application retrouve
        # l'appelant sans croire l'invention (cf. api/forwarded.py).
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;

        # Une question déclenche jusqu'à onze appels LLM et un conteneur : le
        # défaut de 60 s couperait la réponse au milieu, et l'utilisateur
        # verrait un 504 sur une analyse qui, elle, va au bout.
        proxy_connect_timeout  10s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
        # Réponse rendue au fil de l'eau : tamponner n'apporte rien ici et
        # retarde le premier octet d'une réponse longue.
        proxy_buffering off;
    }
}
