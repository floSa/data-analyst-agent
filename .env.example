# Exemple de configuration — copiez ce fichier en `.env` et ajustez.
# Toutes les variables sont préfixées DAA_ (pydantic-settings). Les valeurs
# ci-dessous sont les défauts du code (config.py) : décommentez pour surcharger.

# --- LLM mutualisé (endpoint OpenAI-compatible) ---
# Le moteur n'est PAS nommé dans la configuration : l'application ne parle que
# /v1/chat/completions, servi aussi bien par Ollama que par vLLM. Changer de
# moteur, c'est changer cette URL — et rien d'autre. Cf. docs/VLLM.md.
#
# Ollama (le moteur en service). Service CENTRAL (repo llm-service) : lancer
# `make up` dans llm-service ; il publie Ollama sur le port hôte 11434 → l'URL
# par défaut ci-dessous pointe déjà dessus. Le central sert gemma4:e4b, qui
# est aussi le défaut du code : sans ce fichier, l'application démarre et
# interroge un modèle qui existe. Tout autre modèle doit d'abord être ajouté
# à OLLAMA_MODELS du central.
#DAA_LLM_BASE_URL=http://localhost:11434/v1
#DAA_LLM_MODEL=gemma4:e4b
#DAA_LLM_TEMPERATURE=0.0
# Astuce dev CPU / WSL2 : un modèle plus léger + num_thread limité est bien
# plus rapide. Créez un modèle dérivé (Modelfile : `FROM qwen3.5:4b` +
# `PARAMETER num_thread 8`) et pointez-le ici, p. ex. :
#DAA_LLM_MODEL=qwen3.5-demo:4b
#
# DÉPRÉCIÉ — ancien nom de DAA_LLM_BASE_URL. Toujours honoré pour ne pas casser
# les fichiers en place, avec un avertissement dans les logs au démarrage.
# À renommer ; il sera retiré.
#DAA_OLLAMA_BASE_URL=http://localhost:11434/v1
#
# Clé d'API. Vide par défaut : Ollama n'en demande aucune. À renseigner face à
# un vLLM lancé avec `--api-key`, qui rejette toute requête sans en-tête
# Authorization.
#DAA_LLM_API_KEY=
# Délai d'un appel LLM (secondes) et nombre de RÉESSAIS — donc au pire
# timeout x (1 + max_retries) avant qu'un thread soit rendu. Les défauts du SDK
# OpenAI, 600 s et 2 réessais, faisaient ~30 min. Le réessai ne couvre que le
# transitoire (429, 5xx, coupure) : un refus de contexte (400) n'est pas rejoué.
#DAA_LLM_TIMEOUT=120.0
#DAA_LLM_MAX_RETRIES=2

# --- Agent Récupération ---
#DAA_CATALOG_PATH=sources/catalogue.yaml
#DAA_RETRIEVAL_MAX_ROWS=200
#DAA_RETRIEVAL_REQUEST_LIMIT=10

# --- Agent Analyse ---
#DAA_ANALYSIS_MAX_ATTEMPTS=3
#DAA_ANALYSIS_TABLE_MAX_ROWS=10000

# --- Inférence ML ---
#DAA_MODELS_REGISTRY_PATH=models/registry.yaml

# --- Mémoire de conversation ---
# Chaque conversation persiste ses tableaux intermédiaires (CSV) sous ce dossier
# pour les réutiliser aux tours suivants (« prédis ces lignes », code d'analyse).
# Les dossiers sont créés en 0o700. Défaut : var/workspaces, sous le projet —
# à renseigner ici pour pointer un volume dédié, jamais un chemin sous /tmp
# (purgé périodiquement, et lisible par tout compte local).
#
# Arborescence : $DAA_WORKSPACE_DIR/<utilisateur>/<conversation_id>/ — les fils
# sont rangés par compte, et c'est ce rangement qui les cloisonne. Les verrous
# (.locks/) vivent sous le dossier de l'utilisateur, eux aussi.
#
# Un dossier hérité d'une version antérieure, où les conversations sont posées à
# la RACINE, n'est plus vu par l'application. Pour le reprendre (à blanc par
# défaut, --appliquer pour écrire) :
#     uv run python scripts/migrate_workspace_owner.py --workspace <dossier> --owner <login>
#DAA_WORKSPACE_DIR=var/workspaces

# --- Ce qui entre dans le contexte du modèle ---
# Les tableaux intermédiaires sont réinjectés à chaque tour sur TROIS axes :
# prompt du planificateur, montages --volume de la sandbox, catalogue effectif.
# Sans plafond ils s'accumulent sans fin (mesuré : 100 montages à 100 tours).
#
# Fenêtre glissante : nombre de tableaux réinjectés, les plus récents. 0 = pas
# de fenêtre. Les tableaux évincés RESTENT sur le disque et dans le fil : on
# plafonne ce qu'on injecte, pas ce qu'on conserve.
#DAA_CONTEXT_ARTIFACT_WINDOW=8
# Budget de tokens du prompt du planificateur, décompté AVANT l'appel. Au
# dépassement, les tableaux les PLUS ANCIENS sortent jusqu'à ce que ça tienne.
# 0 = pas de budget. Le compteur est approché (3 caractères par token) et
# surestime de 1 à 17 % : il coupe un peu trop tôt plutôt que trop tard.
#DAA_CONTEXT_TOKEN_BUDGET=8000
#
# Les deux réglages suivants ne coupent RIEN : ils servent à constater qu'un
# débordement a eu lieu, et à le dire à l'utilisateur.
#
# Fenêtre de contexte réellement servie par le serveur. Pour Ollama c'est
# OLLAMA_CONTEXT_LENGTH (32768 sur le service central), et NON les 131 072 que
# déclare gemma4 : c'est la valeur servie qui tronque. Pour vLLM c'est
# --max-model-len. 0 = inconnue.
#DAA_CONTEXT_MODEL_WINDOW=32768
# Filet quand la fenêtre est inconnue ou mal déclarée : on signale si le serveur
# dit avoir évalué moins de cette fraction de notre estimation.
#DAA_CONTEXT_OVERFLOW_RATIO=0.4

# --- Authentification (login + mot de passe, session côté serveur) ---
# Les comptes ne se créent QUE par le CLI, il n'y a pas d'inscription ouverte :
#     uv run python scripts/manage_users.py create <login>
# Le fichier de comptes est écrit en 0600 et n'est pas versionné (forme :
# users.example.yaml). Le login y est normalisé (NFKC, espaces de bord retirés,
# casse repliée) : `floSa` et `FLOSA` sont un seul compte — et un seul dossier
# de conversations.
#DAA_AUTH_ACCOUNTS_PATH=var/users.yaml
#DAA_AUTH_STATE_DIR=var/auth
# Inactivité (1 h) et durée absolue (12 h) d'une session, en secondes.
#DAA_SESSION_IDLE_TIMEOUT=3600
#DAA_SESSION_ABSOLUTE_TIMEOUT=43200
# `Secure` sur le cookie de session : le navigateur ne l'envoie qu'en HTTPS.
# À passer à false UNIQUEMENT pour un développement local en http — sur une
# instance en service, le cookie partirait en clair.
#DAA_SESSION_COOKIE_SECURE=true
#DAA_SESSION_COOKIE_NAME=daa_session
#DAA_CSRF_COOKIE_NAME=daa_csrf
# Anti-force brute : verrouillage temporisé au-delà de N échecs, compté par
# compte ET par adresse.
#DAA_LOGIN_MAX_FAILURES=5
#DAA_LOGIN_LOCKOUT_SECONDS=300

# --- Sandbox d'exécution (Docker, réseau coupé) ---
# JSON pour les listes ; sous Windows, exécuter docker via WSL :
#DAA_SANDBOX_DOCKER_CMD=["docker"]
#DAA_SANDBOX_DOCKER_CMD=["wsl","docker"]
#DAA_SANDBOX_IMAGE=data-analyst-agent-sandbox:0.1
#DAA_SANDBOX_MEM_LIMIT=1g
#DAA_SANDBOX_CPUS=1.0
#DAA_SANDBOX_PIDS_LIMIT=256
#DAA_SANDBOX_START_TIMEOUT=60.0
#DAA_SANDBOX_EXEC_TIMEOUT=30.0
#DAA_SANDBOX_KILL_GRACE=10.0
# Conteneurs sandbox vivants EN MÊME TEMPS, tout le process confondu. Borner la
# mémoire d'UN conteneur ne dit rien de leur NOMBRE : chaque analyse ouvre sa
# session, donc son conteneur, qui réserve DAA_SANDBOX_MEM_LIMIT. Dix analyses
# simultanées réservaient dix gigaoctets sans file d'attente. Au-delà du
# plafond, une session attend puis se voit refusée. À régler sur la RAM
# réellement disponible ; 0 = pas de plafond, en connaissance de cause.
# Attention avec plusieurs workers uvicorn : le compteur est PAR PROCESS, donc
# le plafond réel vaut ce nombre multiplié par le nombre de workers.
#DAA_SANDBOX_MAX_SESSIONS=4
# Attente maximale d'une place, en secondes. Passé ce délai la demande est
# refusée plutôt que mise en attente indéfinie : un utilisateur préfère un refus
# net à un onglet qui tourne. À tenir sous le budget d'une requête HTTP.
#DAA_SANDBOX_QUEUE_TIMEOUT=60.0

# --- Surface HTTP exposée ---
# Documentation interactive (/docs, /redoc, /openapi.json). ÉTEINTE par défaut :
# elle décrit la surface d'attaque à quiconque atteint le port, et ses pages
# chargent Swagger/ReDoc depuis un CDN — qu'un déploiement au réseau coupé ne
# peut de toute façon pas servir. À rallumer pour développer, jamais en service.
# Les TROIS routes s'éteignent ensemble : sans /openapi.json, masquer /docs ne
# cacherait rien, le schéma complet resterait téléchargeable.
#DAA_API_DOCS_ENABLED=false
# Taille maximale du corps d'une requête, en octets, tous chemins confondus (y
# compris /login, qui est ouvert). Le contrôle porte sur Content-Length : une
# requête en `chunked` n'en annonce pas et passe ici — un serveur en frontal
# reste la bonne place pour un plafond dur.
#DAA_API_MAX_BODY_BYTES=65536
# Longueur maximale d'une question. POST /chat déclenche jusqu'à onze appels LLM
# et un conteneur Docker : sans borne, c'est un amplificateur de charge gratuit.
# 4 000 caractères ≈ 1 000 tokens, déjà large devant DAA_CONTEXT_TOKEN_BUDGET.
#DAA_CHAT_MESSAGE_MAX_CHARS=4000
# Débit de POST /chat, par COMPTE, sur une fenêtre glissante (et non un compteur
# remis à zéro, qui laisserait passer deux fois le quota à cheval sur deux
# fenêtres). Le LLM mutualisé sert UNE requête à la fois : une rafale d'un seul
# utilisateur met tous les autres en file. 0 = pas de quota.
#DAA_CHAT_RATE_LIMIT_REQUESTS=20
#DAA_CHAT_RATE_LIMIT_WINDOW=60.0

# --- Source Postgres (référencée par ${...} dans sources/catalogue.yaml) ---
# À renseigner uniquement si vous déclarez une source de type postgres.
# Contrairement aux réglages ci-dessus, ces variables ne sont pas des champs de
# Settings : elles sont publiées dans l'environnement du process (config.py,
# export_env_file) parce que le DSN du catalogue est résolu par expandvars.
#DAA_PG_HOST=localhost
#DAA_PG_PORT=5432
#DAA_PG_USER=postgres
#DAA_PG_PASSWORD=change-me
